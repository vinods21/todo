# SCRUM-7-AC-08: copy to .env to override. Values are LOCAL-DEVELOPMENT defaults, not secrets.
TODO_DB_NAME=todo
TODO_DB_USER=todo
TODO_DB_PASSWORD=todo
TODO_DB_PORT=5432
TODO_BACKEND_PORT=8080
TODO_FRONTEND_PORT=3000
# Origins allowed to call the backend cross-origin (Vite dev server); comma-separated.
TODO_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Image tag for todo-backend / todo-frontend (CI uses <JIRA_KEY>-<sha>).
TODO_IMAGE_TAG=local
# SCRUM-8-AC-15: run a published release instead of local builds (docs/release/RELEASE.md, ROLLBACK.md):
# TODO_BACKEND_IMAGE=ghcr.io/vinods21/todo-backend
# TODO_FRONTEND_IMAGE=ghcr.io/vinods21/todo-frontend
# TODO_IMAGE_TAG=0.1.0
# Per-service tag (wins over TODO_IMAGE_TAG), e.g. pin by digest for a rollback:
# TODO_BACKEND_TAG=0.1.0@sha256:<digest>
# TODO_FRONTEND_TAG=0.1.0@sha256:<digest>
# Version stamped into locally built images (ADR 0013); releases come from Git tags, never from here.
# TODO_VERSION=0.0.0-SNAPSHOT
# Build identity baked into images (ADR 0008/0010); UNKNOWN when unset.
# e.g. JIRA_KEY=SCRUM-7  GIT_COMMIT=$(git rev-parse HEAD)  GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
JIRA_KEY=UNKNOWN
GIT_COMMIT=UNKNOWN
GIT_BRANCH=UNKNOWN
# Optional: COMPOSE_PROFILES=app makes plain `docker compose up -d` start the whole stack.
# SCRUM-13 (ADR 0018/0019): Keycloak — LOCAL DEVELOPMENT ONLY values (README → Authentication).
# Host port of Keycloak; drives KC_HOSTNAME, the token issuer the backend validates and the frontend's AUTH_URL together.
TODO_KEYCLOAK_PORT=8180
# Keycloak bootstrap admin (admin console http://localhost:8180/admin) — dev-only credentials.
TODO_KC_ADMIN_USER=admin
TODO_KC_ADMIN_PASSWORD=admin-dev-only
# Access-token lifetime of realm `todo` in seconds (applied when a new Keycloak container imports the realm).
TODO_KC_ACCESS_TOKEN_LIFESPAN=300
# Backend clock skew for exp/nbf (max 60s; CI e2e uses 5s).
TODO_AUTH_CLOCK_SKEW=30s
# Pinned Keycloak image (default in docker-compose.yml: tag AND digest, SCRUM-13-NFR-04); override only to test upgrades.
# TODO_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.2@sha256:<digest>
