# SCRUM-1-AC-13: origin of the SCRUM-2 backend (no trailing slash, no /api suffix)
VITE_API_BASE_URL=http://localhost:8080
# SCRUM-7-AC-17: '/' = same-origin (requests go to <page origin>/api/…; used by the container image behind nginx)
# VITE_API_BASE_URL=/
# SCRUM-13-AC-16: Keycloak for Vite dev mode (defaults shown; the container image reads /auth-config.json instead).
# VITE_AUTH_URL=http://localhost:8180
# VITE_AUTH_REALM=todo
# VITE_AUTH_CLIENT_ID=todo-frontend
